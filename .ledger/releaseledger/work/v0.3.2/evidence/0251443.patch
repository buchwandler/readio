 ```text
 --spacy auto|off|sm|md|lg|trf
---short-sentence auto|off|wrap|phrase|randomized-phrase
+--short-sentence off|wrap|phrase|randomized-phrase
 --pause-mode auto|tts|manual
 --speed FLOAT
