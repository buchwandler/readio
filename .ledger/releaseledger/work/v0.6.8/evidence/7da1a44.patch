+        "temporary",
+        None,
+        output,
+        (WorkflowStep("render", "voicerender", "replace", None, "Explicit rebuild."),),
+    )
+    inspected: list[object] = []
+    rendered: list[tuple[object, object]] = []
+
+    def inspect(_self: Readio, request: object) -> WorkflowPlan:
+        inspected.append(request)
