@@ -0,0 +1,231 @@
+"""Normalize VoiceRender catalog descriptors into Readio-owned API types."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable, Mapping, Sequence
+
+from readio.api.types import EngineInfo, EngineOptionInfo, TargetInfo, VoiceInfo
+
+_ENGINE_FEATURES = (
+    ("supports_named_voices", "voices"),
+    ("supports_lexicons", "lexicons"),
+    ("supports_model_sources", "model sources"),
+    ("supports_qualities", "qualities"),
+    ("supports_voice_level_calibration", "voice level"),
+    ("reference_audio", "reference audio"),
+)
+_FEATURE_LABELS = {
+    "named_voices": "voices",
+    "lexicons": "lexicons",
+    "model_sources": "model sources",
+    "qualities": "qualities",
+    "voice_level_calibration": "voice level",
+    "pronunciation_overrides": "pronunciation overrides",
+    "reference_voice": "reference audio",
+    "prepared_voice": "prepared voices",
+    "speakers": "speakers",
+    "request_measurement": "request measurement",
+}
+
+
+def _value(record: object, key: str, default: object = None) -> object:
+    if isinstance(record, Mapping):
+        return record.get(key, default)
+    return getattr(record, key, default)
+
+
+def _strings(value: object) -> tuple[str, ...]:
+    if isinstance(value, str):
+        return (value,) if value else ()
+    if isinstance(value, (set, frozenset)):
+        return tuple(sorted(item for item in value if isinstance(item, str) and item))
+    if isinstance(value, Iterable) and not isinstance(value, Mapping):
+        return tuple(item for item in value if isinstance(item, str) and item)
+    return ()
+
+
+def _metadata(record: object) -> Mapping[str, object]:
+    value = _value(record, "metadata")
+    return value if isinstance(value, Mapping) else {}
+
+
+def _capability_names(record: object) -> tuple[str, ...]:
+    capabilities = _value(record, "capabilities")
+    if isinstance(capabilities, Mapping):
+        return tuple(key for key, enabled in capabilities.items() if enabled)
+    return _strings(capabilities)
+
+
+def _features(names: Iterable[str]) -> tuple[str, ...]:
+    return tuple(dict.fromkeys(_FEATURE_LABELS.get(name, name.replace("_", " ")) for name in names))
+
+
+def engine_info(engine: object) -> EngineInfo:
+    identifier = _value(engine, "id")
+    if not isinstance(identifier, str):
+        identifier = str(identifier)
+    installed = bool(_value(engine, "installed", True))
+    version_value = _value(engine, "installed_version") or _value(engine, "version")
+    version = version_value if isinstance(version_value, str) else None
+    features = [label for key, label in _ENGINE_FEATURES if bool(_value(engine, key, False))]
+    features.extend(
+        label for label in _features(_capability_names(engine)) if label not in features
+    )
+    reason_value = _value(engine, "missing_dependency")
+    reason = reason_value if isinstance(reason_value, str) else None
+    return EngineInfo(
+        id=identifier,
+        version=version,
+        installed=installed,
+        runnable=bool(_value(engine, "runnable", installed)),
+        features=tuple(features),
+        reason=reason,
+    )
+
+
+def _target_language_labels(target: object) -> dict[str, str]:
+    labels: dict[str, str] = {}
+    details = _value(target, "voice_details", ())
+    if not isinstance(details, Sequence) or isinstance(details, str):
+        return labels
+    for detail in details:
+        label = _value(detail, "language_label")
+        if not isinstance(label, str) or not label:
+            continue
+        codes = (
+            _value(detail, "language"),
+            _value(detail, "locale"),
+            *_strings(_value(detail, "languages")),
+        )
+        for code in codes:
+            if isinstance(code, str) and code:
+                labels[code.casefold()] = label
+    return labels
+
+
+def target_info(target: object) -> TargetInfo:
+    identifier = _value(target, "id")
+    if not isinstance(identifier, str):
+        identifier = str(identifier)
+    languages = _strings(_value(target, "languages")) or _strings(_value(target, "language"))
+    labels = _target_language_labels(target)
+    languages = tuple(labels.get(language.casefold(), language) for language in languages)
+    voices = _strings(_value(target, "voices"))
+    speakers = _strings(_value(target, "speakers"))
+    default_voice = _value(target, "default_voice")
+    if not isinstance(default_voice, str):
+        default_voice = None
+    capabilities = _capability_names(target)
+    metadata = _metadata(target)
+    requires_reference = (
+        "reference_voice" in capabilities
+        or bool(metadata.get("supports_reference_enrollment"))
+        or bool(metadata.get("supports_voice_enrollment"))
+    )
+    reference_only = requires_reference and not voices and not speakers and default_voice is None
+    status = _value(target, "status", "ready")
+    sample_rate_value = _value(target, "sample_rate")
+    sample_rate = (
+        sample_rate_value
+        if isinstance(sample_rate_value, int) and not isinstance(sample_rate_value, bool)
+        else None
+    )
+    voice_mode_value = metadata.get("voice_mode")
+    voice_mode = voice_mode_value if isinstance(voice_mode_value, str) else None
+    return TargetInfo(
+        id=identifier,
+        languages=languages,
+        status=status if isinstance(status, str) else str(status),
+        runtime_available=bool(_value(target, "runtime_available", True)),
+        default_voice=default_voice,
+        voice_count=len(voices) or len(speakers),
+        qualities=_strings(_value(target, "qualities")),
+        voice_mode=voice_mode,
+        sample_rate=sample_rate,
+        features=_features(capabilities),
+        reference_only=reference_only,
+    )
+
+
+def voice_info(voice: object) -> VoiceInfo | None:
+    identifier = _value(voice, "id")
+    if not isinstance(identifier, str) or not identifier:
+        identifier = _value(voice, "voice")
+    if not isinstance(identifier, str) or not identifier:
+        speaker = _value(voice, "speaker")
+        if speaker is not None:
+            identifier = str(speaker)
+    if not isinstance(identifier, str) or not identifier:
+        identifier = _value(voice, "selector")
+    if not isinstance(identifier, str) or not identifier:
+        return None
+
+    languages = _strings(_value(voice, "languages"))
+    language_value = _value(voice, "language")
+    language = language_value if isinstance(language_value, str) else None
+    if language is None and languages:
+        language = languages[0]
+
+    metadata = _metadata(voice)
+    voice_metadata = metadata.get("voice")
+    if not isinstance(voice_metadata, Mapping):
+        voice_metadata = {}
+    language_label_value = _value(voice, "language_label") or voice_metadata.get("language_label")
+    language_label = language_label_value if isinstance(language_label_value, str) else None
+    locale_value = _value(voice, "locale")
+    locale = locale_value if isinstance(locale_value, str) else None
+    gender_value = _value(voice, "gender")
+    gender = gender_value if isinstance(gender_value, str) and gender_value else "unknown"
+    kind_value = _value(voice, "kind")
+    kind_value = getattr(kind_value, "value", kind_value)
+    kind = kind_value if isinstance(kind_value, str) else None
+    target_metadata = metadata.get("target")
+    default_voice = _value(target_metadata, "default_voice")
+    explicit_default = bool(_value(voice, "default", False))
+    default = explicit_default or (
+        isinstance(default_voice, str)
+        and (identifier == default_voice or _value(voice, "voice") == default_voice)
+    )
+    installed = _value(voice, "installed", True)
+    runtime_available = bool(_value(voice, "runtime_available", installed))
+    return VoiceInfo(
+        id=identifier,
+        language=language,
+        locale=locale,
+        language_label=language_label,
+        gender=gender,
+        kind=kind,
+        default=default,
+        runtime_available=runtime_available,
+    )
+
+
+def _optional_number(value: object) -> int | float | None:
+    if isinstance(value, (int, float)) and not isinstance(value, bool):
+        return value
+    return None
+
+
+def engine_option_info(option: object) -> EngineOptionInfo:
+    name = _value(option, "name")
+    if not isinstance(name, str) or not name:
+        raise ValueError("An engine option must have a non-empty name.")
+    value_type = _value(option, "value_type")
+    raw_choices = _value(option, "choices", ())
+    choices = tuple(raw_choices) if isinstance(raw_choices, (tuple, list)) else ()
+    description = _value(option, "description", "")
+    return EngineOptionInfo(
+        name=name,
+        value_type=value_type if isinstance(value_type, str) else None,
+        required=bool(_value(option, "required", False)),
+        default=_value(option, "default"),
+        choices=choices,
+        minimum=_optional_number(_value(option, "minimum")),
+        maximum=_optional_number(_value(option, "maximum")),
+        description=description if isinstance(description, str) else "",
+        identity_affecting=bool(_value(option, "identity_affecting", False)),
+        runtime_only=bool(_value(option, "runtime_only", False)),
+    )
+
+
+__all__ = ["engine_info", "engine_option_info", "target_info", "voice_info"]
