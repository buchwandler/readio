+    buffer = AudioBuffer(audio=np.array([0.25, -0.25], dtype=np.float32), sample_rate=22050)
+
+    assert buffer.write_wav(path) == path
+    assert path.read_bytes() == buffer.to_wav_bytes()
+    with pytest.raises(OutputCollisionError):
